<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Whispers</AssemblyName>
    <RootNamespace>Whispers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="Exists('tools/ffmpeg.exe')">
    <Content Include="tools/ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="tools/ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="ValidateBundledTools" BeforeTargets="Publish">
    <Error Condition="!Exists('tools/ffmpeg.exe')" Text="FFmpeg ausente. Execute scripts/Get-FFmpeg.ps1 antes de publicar." />
    <Error Condition="!Exists('tools/ffprobe.exe')" Text="FFprobe ausente. Execute scripts/Get-FFmpeg.ps1 antes de publicar." />
  </Target>
</Project>
